{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muvy",
  "main": "src/index.js",
  "workers_dev": true,
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "muvy.shop", "custom_domain": true },
    { "pattern": "www.muvy.shop", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // Secreto requerido (no va en este archivo): DROPI_TOKEN
  // Se configura en Cloudflare → Workers → muvy → Settings → Variables and Secrets.
}
